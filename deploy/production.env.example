# Read docs/UBUNTU_VPS_GITHUB_ACTIONS.md before editing.
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com

APP_NAME="Clyvero ERP"
APP_ENV=production
APP_KEY=REPLACE_APP_KEY
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clyvero
DB_USERNAME=clyvero
DB_PASSWORD=REPLACE_DB_PASSWORD

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=720
TRUSTED_PROXIES=*

# Use the settings supplied by your SMTP provider. Keep OTP enabled.
# Use single quotes around passwords containing $, #, or spaces.
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_SMTP_USERNAME
MAIL_PASSWORD='REPLACE_SMTP_PASSWORD'
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=REPLACE_SENDER_EMAIL
MAIL_FROM_NAME="Clyvero ERP"

FILESYSTEM_DISK=public
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
ADMIN_LOGIN_OTP_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_VERIFY_PER_MINUTE=6
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3
RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=3
RATE_LIMIT_API_PER_MINUTE=120
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30
