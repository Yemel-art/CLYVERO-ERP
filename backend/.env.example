APP_NAME="Clyvero ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache

# ─── School Identity (seeded into `schools` table on first migrate) ───
SCHOOL_NAME="Your School Name"
SCHOOL_SLUG=your-school
SCHOOL_SLOGAN="Excellence through learning"
SCHOOL_EMAIL=school@example.com
SCHOOL_PHONE=+237600000000
SCHOOL_ADDRESS="Yaoundé, Cameroon"
SCHOOL_WEBSITE=https://school.example.com
SCHOOL_CITY=Yaoundé
SCHOOL_COUNTRY=Cameroon

# ─── Bootstrap Administrator (seeded on first migrate; change immediately) ───
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# ─── Database (PostgreSQL via Sail) ───
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=clyvero
DB_USERNAME=sail
DB_PASSWORD=password

# ─── Sanctum ───
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
SESSION_DRIVER=cookie
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=false

# ─── Frontend Origin (for CORS) ───
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Cache / Queue / Session (Redis) ───
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (Mailpit in dev; SMTP in prod) ───
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Storage ───
FILESYSTEM_DISK=local

# ─── Logging ───
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=daily
LOG_DAILY_DAYS=14

# ─── Sail (Docker) ───
WWWGROUP=1000
WWWUSER=1000
SAIL_XDEBUG_MODE=off
APP_PORT=80
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ─── Bcrypt rounds ───
BCRYPT_ROUNDS=12

# ─── Rate Limiting Tunables ───
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_VERIFY_PER_MINUTE=6
ADMIN_LOGIN_OTP_ENABLED=false
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3
RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=3
RATE_LIMIT_API_PER_MINUTE=100
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30
