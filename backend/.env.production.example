APP_NAME="Clyvero ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clyvero
DB_USERNAME=clyvero
DB_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=720
TRUSTED_PROXIES=*

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=school-system@example.com
MAIL_PASSWORD=REPLACE_WITH_PROVIDER_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=school-system@example.com
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

ADMIN_LOGIN_OTP_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_OTP_VERIFY_PER_MINUTE=6
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3
RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=3
RATE_LIMIT_API_PER_MINUTE=120
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30

API_DOMAIN=api.example.com
