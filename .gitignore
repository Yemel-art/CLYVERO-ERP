# Dependencies and generated builds
/backend/vendor/
/frontend/node_modules/
/frontend/.next/
/frontend/.vercel/
/frontend/out/

# Secrets and local environment files (at any depth)
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
!**/.env.testing.example
**/.env.before-*
**/.env.gmail-backup-*
**/*.pem
**/*.key
**/auth.json

# Application-generated data
/backend/storage/app/public/*
!/backend/storage/app/public/.gitkeep
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/public/storage

# Backups must live outside source control
/.codex-backups/
/backups/
*.dump
*.sql
*.tar.gz

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing and logs
/backend/.phpunit.result.cache
/backend/.phpunit.cache/
/frontend/coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.tools/
/.preview-logs/
/.next/
/.codex-validation/
*.tsbuildinfo

# Codex local safety backups at any depth
**/.codex-backups/

# Local source snapshots
frontend/src/app/(auth)/login/page.tsx.*-backup-*
