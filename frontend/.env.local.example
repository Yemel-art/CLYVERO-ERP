# Origin of the Laravel backend. The Next.js dev server proxies /api/* to this.
NEXT_PUBLIC_API_URL=http://localhost

# Public-facing app name (shown in titles, etc.)
NEXT_PUBLIC_APP_NAME="The Laureates"

# School name (sourced from the backend at runtime, but this is a build-time fallback)
NEXT_PUBLIC_SCHOOL_NAME="The Laureates"
